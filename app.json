{
  "expo": {
    "name": "Quilly",
    "slug": "quilly",
    "owner": "yunieyeonseolee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quilly-icon.png",
    "scheme": "quilly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yunieyeonseolee.quilly",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yunieyeonseolee.quilly",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7FB",
        "foregroundImage": "./assets/images/quilly-adaptive-foreground.png",
        "backgroundImage": "./assets/images/quilly-adaptive-background.png",
        "monochromeImage": "./assets/images/quilly-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/quilly-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quilly-splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d785eb6d-626e-4a22-a681-f654092bafed"
      }
    }
  }
}
